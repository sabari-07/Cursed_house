{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--browser", "chrome",
        "--headless",
        "--isolated",
        "--viewport-size", "1600,900",
        "--output-dir", "tests/browser/out/mcp"
      ],
      "disabled": false,
      "autoApprove": ["browser_navigate", "browser_snapshot", "browser_take_screenshot", "browser_console_messages", "browser_wait_for"]
    }
  }
}
